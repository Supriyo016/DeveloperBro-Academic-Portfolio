# Public origin of the deployed site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form. Only the API key is required. Without it the form reports that it is unavailable and shows the email link.
# Messages go to supriyo.sarkar016@gmail.com from Resend's shared sender unless these are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional. Signs the contact form token. Falls back to RESEND_API_KEY. Any long random string.
CONTACT_FORM_SECRET=

# Optional. Raises the GitHub API limit from 60 to 5,000 requests per hour. Needs no scopes.
GITHUB_TOKEN=
