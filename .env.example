# Public origin of the deployed site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form. Without these the form reports that it is unavailable and shows the email link.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional. Raises the GitHub API limit from 60 to 5,000 requests per hour. Needs no scopes.
GITHUB_TOKEN=
